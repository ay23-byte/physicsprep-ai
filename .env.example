# Copy this file to .env and fill in your own values.
# Never commit .env or real API keys.

PORT=3001
GEMINI_API_KEY=
# Optional comma-separated extra browser origins:
# CORS_ORIGINS=http://localhost:5173

# Random secret of at least 32 characters for signed session cookies
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Razorpay subscription billing (keep all secrets server-side; never use VITE_ prefixes)
# Create matching monthly/yearly subscription plans in Razorpay and paste their plan IDs below.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_YEARLY=
# Displayed amounts in paise: ₹499/month and ₹4,999/year by default.
BILLING_PRO_MONTHLY_PRICE=49900
BILLING_PRO_YEARLY_PRICE=499900
